  "panels": [
    {
      "title": "Provider Request Latency (p95)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(provider_request_duration_seconds_bucket[5m]))",
          "legendFormat": "{{endpoint}}"
        }
      ]
    },
    {
      "title": "Consumer Request Latency (p95)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(consumer_request_duration_seconds_bucket[5m]))",
          "legendFormat": "{{endpoint}}"
        }
      ]
    },
    {
      "title": "Provider Request Rate",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [
        {
          "expr": "rate(provider_requests_total[5m])",
          "legendFormat": "{{method}} {{endpoint}} {{status}}"
        }
      ]
    },
    {
      "title": "Consumer Request Rate",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [
        {
          "expr": "rate(consumer_requests_total[5m])",
          "legendFormat": "{{method}} {{endpoint}} {{status}}"
        }
      ]
    },
    {
      "title": "Pod CPU Usage",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "targets": [
        {
          "expr": "rate(container_cpu_usage_seconds_total{namespace=\"mvds\"}[5m])",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "title": "Pod Memory Usage",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "targets": [
        {
          "expr": "container_memory_usage_bytes{namespace=\"mvds\"}",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "title": "Connector Availability",
      "type": "stat",
      "gridPos": {"h": 4, "w": 24, "x": 0, "y": 24},
      "targets": [
        {
          "expr": "provider_up",
          "legendFormat": "Provider"
        },
        {
          "expr": "consumer_up",
          "legendFormat": "Consumer"
        }
      ]
    }
